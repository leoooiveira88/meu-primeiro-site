---
// Card branco com ícone, título, texto e uma barra que se preenche no hover.
// Usado na seção "A ferramenta invisível para ideias tangíveis".
// Uso:
//   <FeatureCard icon="solar:scale-linear" title="Equilíbrio Neutro" order={3}>
//       Texto do card.
//   </FeatureCard>
//
// icon:  nome de um ícone do Iconify
// title: título do card
// order: posição do card na fileira (1, 2, 3...). Define o atraso das
//        animações, para os cards aparecerem um depois do outro.
// O texto do card vai entre as tags (slot).

interface Props {
	icon: string;
	title: string;
	order?: number;
}

const { icon, title, order = 1 } = Astro.props;

// Card 1 → delay-200, card 2 → delay-400, card 3 → delay-600
const revealDelay = `delay-${order * 200}`;
// Barra do card 1 → sem atraso, card 2 → delay-100, card 3 → delay-200
const barDelay = order > 1 ? `delay-${(order - 1) * 100}` : "";
---

<div
    class={`flashlight-card h-[400px] border border-stone-300 bg-white p-8 flex flex-col justify-between rounded-sm hover:shadow-2xl hover:-translate-y-1 transition-all duration-500 group reveal-up ${revealDelay}`}
    onmousemove="updateFlashlight(event, this)">
    <div
        class="w-12 h-12 bg-stone-100 rounded-lg flex items-center justify-center text-stone-900 mb-6 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-500">
        <iconify-icon icon={icon} class="text-2xl"></iconify-icon>
    </div>
    <div>
        <h3 class="text-2xl font-display font-medium mb-3">{title}</h3>
        <p class="text-stone-500 text-sm leading-relaxed"><slot /></p>
    </div>
    <div class="h-1 w-full bg-stone-100 mt-8 overflow-hidden">
        <div class={`h-full bg-stone-900 w-0 group-hover:w-full transition-all duration-700 ease-out ${barDelay}`}>
        </div>
    </div>
</div>
